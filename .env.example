# ═══════════════════════════════════════════════════════════════
# LLM Context Compaction Proxy — Configuration Template
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Core Settings ──────────────────────────────────────────────

# Port the proxy listens on
COMPACTION_PROXY_PORT=8198

# Upstream LLM API base URL (the real API endpoint)
# Examples:
#   OpenAI:       https://api.openai.com/v1
#   Anthropic:    https://api.anthropic.com
#   DeepSeek:     https://api.deepseek.com/v1
#   Gemini:       https://generativelanguage.googleapis.com
#   Ollama:       http://localhost:11434/v1
#   vLLM:         http://localhost:8000/v1
#   LiteLLM:      http://localhost:4000/v1
#   OpenRouter:   https://openrouter.ai/api/v1
COMPACTION_PROXY_UPSTREAM=http://localhost:11434/v1

# Whether the upstream is Anthropic-format (auto-detected if "auto")
# Options: auto, true, false
COMPACTION_PROXY_UPSTREAM_IS_ANTHROPIC=auto

# Model used for compaction/summarization (must be available at upstream)
COMPACTION_PROXY_MODEL=gpt-4o-mini

# Default model for requests without a model field
COMPACTION_PROXY_DEFAULT_MODEL=gpt-4o-mini

# ── Compaction Behavior ───────────────────────────────────────

# Number of recent conversation turns to keep (not compacted)
COMPACTION_PROXY_KEEP_TURNS=6

# Maximum retries for compaction API calls
COMPACTION_PROXY_MAX_RETRIES=3

# Timeout in seconds for compaction API calls
COMPACTION_PROXY_TIMEOUT=120

# Number of parallel compaction blocks for large conversations
COMPACTION_PROXY_PARALLEL_BLOCKS=3

# Threshold (0.0-1.0) at which preemptive compaction triggers
# 0.80 = compact when context is 80% full
COMPACTION_PROXY_PREEMPTIVE_THRESHOLD=0.80

# ── Thrashing Detection ───────────────────────────────────────

# Max compactions within the window before thrashing is detected
COMPACTION_PROXY_THRASHING_COMPACTS=3

# Number of messages in the thrashing detection window
COMPACTION_PROXY_THRASHING_WINDOW=5

# ── Token Budget ──────────────────────────────────────────────

# Tokens reserved for model response output
COMPACTION_PROXY_RESPONSE_BUDGET=8000

# Safety margin tokens (buffer against estimation errors)
COMPACTION_PROXY_SAFETY_MARGIN=4000

# ── Dual-Layer Compression ────────────────────────────────────

# Compression engine: default, dual-layer
COMPACTION_PROXY_ENGINE=default

# Gateway ratio for dual-layer (keep 15% = 85% reduction)
COMPACTION_PROXY_DUAL_GATEWAY_RATIO=0.15

# Agent ratio for dual-layer (keep 50% of L1 output)
COMPACTION_PROXY_DUAL_AGENT_RATIO=0.50

# ── Provider Configuration ────────────────────────────────────

# Provider for compaction API calls: auto, openai, anthropic, gemini
COMPACTION_PROXY_COMPACTION_PROVIDER=auto

# Provider for request forwarding: auto, openai, anthropic, gemini
COMPACTION_PROXY_REQUEST_PROVIDER=auto

# Separate upstream URL for compaction model (empty = same as COMPACTION_PROXY_UPSTREAM)
# Useful when using a cheaper model on a different provider for compaction
COMPACTION_PROXY_COMPACTION_UPSTREAM=

# Separate API key for compaction model (empty = use request key)
COMPACTION_PROXY_COMPACTION_API_KEY=

# ── Security ──────────────────────────────────────────────────

# API secret for authenticating requests to the proxy itself
# Set this to require authentication for proxy access
COMPACTION_PROXY_API_SECRET=

# Enable automatic secret redaction in messages (1=on, 0=off)
COMPACTION_PROXY_REDACT_SECRETS=1

# ── Session & Memory ──────────────────────────────────────────

# Number of background sessions for parallel compaction
COMPACTION_PROXY_BACKGROUND_SESSIONS=3

# Enable LLM-based memory extraction from conversations (1=on, 0=off)
COMPACTION_PROXY_LLM_MEMORY=1

# Paths (defaults use ~/.local/share/compaction-proxy/)
# COMPACTION_PROXY_SEMANTIC_MEMORY=~/.local/share/compaction-proxy/semantic-memory.json
# COMPACTION_PROXY_SESSION_DB=~/.local/share/compaction-proxy/sessions.db
# COMPACTION_PROXY_USER_PROFILE=~/.local/share/compaction-proxy/user-profile.md

# ── Hooks ─────────────────────────────────────────────────────

# Webhook URLs called before/after compaction (empty = disabled)
COMPACTION_PROXY_PRE_HOOK=
COMPACTION_PROXY_POST_HOOK=

# Timeout in seconds for webhook calls
COMPACTION_PROXY_HOOK_TIMEOUT=5

# ── MemSkill (Self-Improving Skills) ──────────────────────────

# Enable MemSkill self-improving compression skills (1=on, 0=off)
COMPACTION_PROXY_MEMSKILL=0

# Interval between skill designer runs (in messages)
COMPACTION_PROXY_MEMSKILL_DESIGNER_INTERVAL=100

# Max skill edits per designer round
COMPACTION_PROXY_MEMSKILL_MAX_EDITS=3

# Exploration temperature for skill design
COMPACTION_PROXY_MEMSKILL_TAU=0.3

# Auto-activate newly designed skills (1=on, 0=off)
COMPACTION_PROXY_MEMSKILL_AUTO_ACTIVATE=1

# ── Logging ───────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR
COMPACTION_PROXY_LOG_LEVEL=INFO

# Log file path (empty = stderr only)
# COMPACTION_PROXY_LOG_FILE=~/.local/share/compaction-proxy/proxy.log
